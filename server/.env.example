# All settings are prefixed with BIRDEAR_
BIRDEAR_DATA_DIR=./data
BIRDEAR_DATABASE_URL=sqlite:///./data/birdear.db
# "birdnet" for real inference, "mock" for development without the model
BIRDEAR_CLASSIFIER=birdnet
BIRDEAR_WORKER_THREADS=2
BIRDEAR_MIN_CONFIDENCE=0.5
BIRDEAR_MAX_UPLOAD_MB=15
BIRDEAR_CORS_ORIGINS=["*"]
